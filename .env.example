# --- Core -----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://triage:triage@localhost:5432/ticket_triage
# 32+ random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
PUBLIC_BASE_URL=http://localhost:8000
# Set to true behind HTTPS so the session cookie is Secure.
SECURE_COOKIES=false

# --- Webhook sources ------------------------------------------------------
# JSON map of source name -> HMAC secret. Each source posts to
# /webhooks/tickets/<source> with an X-Triage-Signature header.
WEBHOOK_SECRETS={"website-contact-form": "replace-with-a-long-random-secret"}
# Optional: Postmark inbound email -> /webhooks/postmark (HTTP basic auth).
POSTMARK_INBOUND_USER=
POSTMARK_INBOUND_PASSWORD=

# --- LLM ------------------------------------------------------------------
# anthropic (default model claude-opus-5-5) or openai (default gpt-5.4-mini)
LLM_PROVIDER=anthropic
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# USD per 1M tokens, for cost-per-ticket reporting. Check your provider's price list.
LLM_PRICE_INPUT_PER_MTOK=4.00
LLM_PRICE_OUTPUT_PER_MTOK=20.00

# --- HubSpot --------------------------------------------------------------
# Private app token with scopes: tickets, crm.objects.contacts.read,
# crm.objects.contacts.write. Leave empty to run without a CRM.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_ID=0
HUBSPOT_PIPELINE_STAGE_ID=1
# Used only to build links to tickets in the HubSpot UI.
HUBSPOT_PORTAL_ID=

# --- Measurement ----------------------------------------------------------
# Share of tickets triaged fully by hand (AI runs hidden, in shadow mode).
MANUAL_BASELINE_RATE=0.1
